# 复制为 .env 后填写。不要提交真实密钥。
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
# Admin 配置启用相应厂商时填写。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
MINERU_TOKEN=
SEARCH_API_KEY=

MYSQL_DATABASE=tian_agent
MYSQL_USER=tian_agent
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Admin task/tool-audit/profile persistence (local JVM launch; Compose sets these internally).
AGENT_PERSISTENCE_BACKEND=mysql
AGENT_MYSQL_URL=jdbc:mysql://localhost:3306/tian_agent?connectTimeout=5000&socketTimeout=10000&serverTimezone=Asia/Shanghai&characterEncoding=utf8
AGENT_MYSQL_USERNAME=tian_agent
AGENT_MYSQL_PASSWORD=replace-with-strong-password
# One-time, idempotent import of legacy tmp/tasks/*.json. Original files are retained.
AGENT_IMPORT_LEGACY_TASKS=false

# RabbitMQ and tool-audit settings are configured directly in application.yml
# and deploy/rabbitmq/rabbitmq.conf; no RabbitMQ .env entries are required.

# 可选端口覆盖
ADMIN_PORT=8123
DOC_MCP_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JVM 容器资源参数
ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
DOC_MCP_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
