# 复制到后端根目录的 .env 后填写。不要提交真实密钥。
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
MINERU_TOKEN=
SEARCH_API_KEY=

# 本地后端从 .env 读取密码，连接地址和账号在 application.yml 中配置。
MYSQL_PASSWORD=replace-with-strong-password

# 容器在本机发布的端口
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
