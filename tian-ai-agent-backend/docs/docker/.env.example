# 复制到后端根目录的 .env 后填写。不要提交真实密钥。
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
MINERU_TOKEN=
SEARCH_API_KEY=
# 仅本机开发可设为 true，允许管理员在未保存个人凭据时使用上面的值。
PERSONAL_SETTINGS_ADMIN_ENV_FALLBACK=false

# MySQL root 密码由后端和 Compose 共用。
MYSQL_DATABASE=tian_ai_agent
MYSQL_PASSWORD=replace-with-strong-password
# 后端在宿主机运行时，填入 MySQL 所在 Docker 网络的网关 IP。
MYSQL_ROOT_HOST=localhost

# 容器在本机发布的端口
MYSQL_PORT=13306
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
