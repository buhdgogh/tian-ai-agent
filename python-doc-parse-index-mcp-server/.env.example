# Service
MCP_HOST=127.0.0.1
MCP_PORT=8081
MCP_PATH=/mcp
MCP_LOG_LEVEL=info
FASTMCP_CHECK_FOR_UPDATES=off

# Local runtime state. Relative paths are resolved from mcp_server/.
KNOWLEDGE_DB_PATH=storage/knowledge.db
PARSED_DIR=parsed
DOCUMENT_RUNTIME_DIR=runtime
REMOTE_SOURCE_MAX_BYTES=262144000

# Redis vector store
REDIS_URL=redis://localhost:6380
REDIS_INDEX_NAME=knowledge_base
REDIS_INDEX_PREFIX=knowledge_base/vector
REDIS_VECTOR_DIMS=1024
REDIS_DELETE_SCAN_COUNT=500
REDIS_DELETE_BATCH_SIZE=500

# DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_RERANK_ENDPOINT=
EMBEDDING_MODEL=text-embedding-v3
LLM_MODEL=qwen-plus
RERANK_MODEL=qwen3.7-text-rerank

# MinerU: never commit a real token.
MINERU_TOKEN=
MINERU_NETWORK_RETRIES=3
MINERU_NETWORK_RETRY_BASE_SECONDS=1
MINERU_PROXY_AUTO_DETECT=true

# Retrieval
RETRIEVAL_TOP_K=15
RERANK_TOP_N=5
MIN_VECTOR_SCORE=0.15
MIN_RERANK_SCORE=0.10
MIN_BM25_TERM_COVERAGE=0.20
HYBRID_DENSE_WEIGHT=0.65
HYBRID_BM25_WEIGHT=0.35
EXACT_ENTITY_BOOST=0.30
SECTION_MATCH_BOOST=0.15
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_COUNT=2
LOG_RETRIEVAL_CHUNKS=true
CHUNK_SIZES=4096,1024,256
MAX_CONTEXT_TOTAL_CHARS=12000
EVIDENCE_PARENT_MAX_CHARS=3000
EVIDENCE_NEIGHBOR_WINDOW=0
ANSWER_PLANNING_MODE=adaptive
ANSWER_VALIDATION_MODE=high_risk
QA_MAX_OUTPUT_TOKENS=800
OVERVIEW_MAX_OUTPUT_TOKENS=8192

# Evaluation (OpenAI-compatible judge endpoint is supported)
EVAL_GENERATOR_MODEL=qwen-plus
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=gpt-4o-mini
RAGAS_DO_NOT_TRACK=true

# Parse workers. One is the safest setting while learning/debugging.
DOCUMENT_PARSE_WORKERS=1
